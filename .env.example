# ====== Identité de la marque ======
BRAND_NAME=Ndolo Invitations
# Numéro WhatsApp de ton business (format international sans +)
BUSINESS_WHATSAPP=237657664546
BUSINESS_EMAIL=contact@ndolo.cm

# URL publique (utilisée dans les liens WhatsApp, QR codes, aperçus)
BASE_URL=http://localhost:3000
PORT=3000

# ====== Sécurité ======
# Mot de passe de TON espace admin (/admin) — change-le !
ADMIN_PASSWORD=change-moi
# Chaîne aléatoire longue pour signer les cookies
SESSION_SECRET=remplace-par-une-longue-chaine-aleatoire

# ====== Paiements Notch Pay (cagnotte MoMo / OM) ======
# Dashboard Notch Pay > Settings > API Keys
NOTCHPAY_PUBLIC_KEY=
# Dashboard Notch Pay > Settings > Webhooks (hash key, ex: hsk_...)
NOTCHPAY_WEBHOOK_HASH=
# Si aucune clé Notch Pay : true = paiements simulés (démo), false = paiement en ligne désactivé
DEMO_PAYMENTS=true
# Commission prélevée sur la cagnotte en ligne (en %, 0 = aucune)
CAGNOTTE_FEE_PERCENT=5

# ====== Notifications automatiques (optionnel) ======
# Bot Telegram pour recevoir commandes / RSVP / dons en temps réel sur ton téléphone
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ====== Stockage ======
# Dossier contenant la base SQLite et les photos (monter un volume persistant en prod)
DATA_DIR=./data
