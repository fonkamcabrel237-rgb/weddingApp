<%- include('partials/simple-head', { title: 'Pass — ' + guest.name }) %>
  <div class="card" style="max-width:420px;margin:0 auto;padding:1.25rem;text-align:center">
    <p class="small-caps" style="margin:0 0 .25rem;color:var(--gold)">Pass d'entrée officiel</p>
    <h1 class="script" style="margin:0 0 .25rem"><%= coupleNames(w) %></h1>
    <p class="muted" style="margin:0 0 1rem;font-size:.9rem">
      <%= fmtDate(w.event_date) %>
      <% if (w.venue_name || w.city) { %><br><%= [w.venue_name, w.city].filter(Boolean).join(' · ') %><% } %>
    </p>

    <!-- Image du Pass QR incluant le QR code, le nom de l'invité et le nom de sa table -->
    <div style="margin:0 auto .9rem;max-width:320px;border-radius:18px;overflow:hidden;box-shadow:0 10px 28px rgba(0,0,0,.14)">
      <img src="/i/<%= w.slug %>/pass/<%= guest.token %>/ticket.svg" alt="Pass QR — <%= guest.name %> — <%= guest.table_name || 'Table à l\'accueil' %>" style="width:100%;height:auto;display:block">
    </div>

    <!-- Rappel ultra-lisible pour le protocole -->
    <div style="background:#18130d;color:#fff;border:2px solid #c89d3c;border-radius:14px;padding:.85rem 1rem;margin-bottom:.9rem">
      <div style="font-size:.72rem;text-transform:uppercase;letter-spacing:.12em;color:#c89d3c;font-weight:700">Invité(e) &amp; Table attribuée</div>
      <div style="font:700 1.25rem/1.25 'Cormorant Garamond',serif;margin-top:.2rem"><%= guest.name %> (<%= guest.attending_count %> pers.)</div>
      <div style="font:700 1.15rem/1.3 Inter,sans-serif;color:#f3d486;margin-top:.35rem">
        🪑 <%= guest.table_name ? guest.table_name : 'Table communiquée à l\'accueil' %>
      </div>
      <% if (guest.seat_numbers) { %>
        <div style="font-size:.86rem;color:#d9c398;margin-top:.15rem">Siège(s) n° <strong><%= guest.seat_numbers %></strong></div>
      <% } %>
    </div>

    <div style="display:flex;flex-direction:column;gap:.55rem">
      <a class="btn btn-gold btn-block" href="/i/<%= w.slug %>/pass/<%= guest.token %>/ticket.svg?dl=1" download="pass-<%= w.slug %>-<%= guest.token %>.svg">
        📥 Télécharger mon Pass QR
      </a>
      <a class="btn btn-outline btn-block" href="/i/<%= w.slug %>?g=<%= guest.token %>">← Retour au faire-part</a>
    </div>
  </div>
</main></body></html>
