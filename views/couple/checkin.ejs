<%- include('../partials/head', { title: 'Contrôle entrée', noindex: true, bodyClass: 'couple', extraCss: 'couple.css' }) %>
<header class="cp-header">
  <div class="cp-wrap">
    <a class="cp-icon-btn" href="/espace/<%= w.slug %>/accueil" aria-label="Retour"><i class="fa-solid fa-arrow-left"></i></a>
    <h1 class="cp-names" style="flex:1">Scan Pass QR<small><%= coupleNames(w) %></small></h1>
  </div>
</header>

<main class="cp-wrap" style="padding-top:18px;padding-bottom:28px">
  <% if (!guest) { %>
    <div class="cp-card" style="text-align:center;border-color:var(--red);background:#fdecec">
      <div style="font-size:3rem">⛔</div>
      <h2 style="margin:.4rem 0">Pass invalide</h2>
      <p class="muted">Ce QR code ne correspond à aucun invité enregistré pour <%= coupleNames(w) %>.</p>
      <a class="cp-btn dark" href="/espace/<%= w.slug %>/accueil"><i class="fa-solid fa-list"></i> Retour à la liste d'accueil</a>
    </div>
  <% } else if (guest.status !== 'yes') { %>
    <div class="cp-card" style="text-align:center;border-color:var(--red);background:#fdecec">
      <div style="font-size:3rem">⚠️</div>
      <h2 style="margin:.4rem 0"><%= guest.name %></h2>
      <p>Cet invité n'a <strong>pas confirmé</strong> sa présence (<%= guest.status === 'no' ? 'a répondu absent' : 'sans réponse' %>).</p>
      <a class="cp-btn dark" href="/espace/<%= w.slug %>/accueil"><i class="fa-solid fa-list"></i> Retour à la liste d'accueil</a>
    </div>
  <% } else {
    const catInfo = GUEST_CATEGORIES[guest.category] || GUEST_CATEGORIES.famille_mariee;
    const alreadyIn = guest.checked_in_at && !done;
  %>
    <div class="cp-card" style="text-align:center;padding:20px;border:2px solid <%= alreadyIn ? '#e6a700' : (done ? 'var(--green)' : 'var(--gold)') %>">
      <div style="font-size:2.8rem"><%= alreadyIn ? '🔁' : (done ? '✅' : '🎟️') %></div>
      <h2 style="font:700 1.5rem/1.25 'Cormorant Garamond',serif;margin:.3rem 0"><%= guest.name %></h2>
      <p style="margin:0 0 .8rem;font-weight:700;font-size:1.05rem"><%= guest.attending_count %> personne(s) · <span style="color:var(--muted)"><%= catInfo.short %></span></p>

      <!-- Bloc Orientation Table Géant pour l'hôtesse / protocole -->
      <div style="background:#18130d;color:#fff;border:2px solid #c89d3c;border-radius:16px;padding:16px 14px;margin:12px 0">
        <div style="font-size:.74rem;text-transform:uppercase;letter-spacing:.12em;color:#c89d3c;font-weight:700">Installer l'invité à :</div>
        <div style="font:700 1.45rem/1.25 Inter,sans-serif;color:#f3d486;margin-top:6px">
          🪑 <%= guest.table_name ? guest.table_name : 'Table non attribuée' %>
        </div>
        <% if (guest.seat_numbers) { %>
          <div style="font-size:1rem;color:#fff;margin-top:4px;font-weight:600">Siège(s) n° <strong><%= guest.seat_numbers %></strong></div>
        <% } %>
      </div>

      <% if (alreadyIn) { %>
        <div class="cp-banner warn" style="margin:10px 0;justify-content:center">
          <i class="fa-solid fa-clock-rotate-left"></i>
          <div><strong>Pass déjà scanné</strong> à <%= guest.checked_in_at.slice(11, 16) %> UTC.</div>
        </div>
        <a class="cp-btn dark" href="/espace/<%= w.slug %>/accueil"><i class="fa-solid fa-arrow-left"></i> Retour à l'accueil</a>
      <% } else if (done) { %>
        <div class="cp-banner ok" style="margin:10px 0;justify-content:center">
          <i class="fa-solid fa-circle-check"></i>
          <div><strong>Entrée validée !</strong> Accompagnez <%= guest.name %> vers <strong><%= guest.table_name || 'sa place' %></strong>.</div>
        </div>
        <a class="cp-btn dark" href="/espace/<%= w.slug %>/accueil"><i class="fa-solid fa-users"></i> Invité suivant</a>
      <% } else { %>
        <form method="post" style="margin-top:12px">
          <button class="cp-btn gold" style="min-height:54px;font-size:1.02rem"><i class="fa-solid fa-check-double"></i> Valider l'entrée et installer</button>
        </form>
      <% } %>
    </div>
  <% } %>
</main>
</body></html>
