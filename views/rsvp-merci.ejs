<%- include('partials/simple-head', { title: 'Merci ' + guest.name }) %>
  <div class="card" style="max-width:420px;margin:0 auto">
    <div class="big-emoji"><%= guest.status === 'yes' ? '🥂' : '💐' %></div>
    <h1 class="script"><%= guest.status === 'yes' ? 'Merci ' + guest.name.split(' ')[0] + ' !' : 'Merci pour votre réponse' %></h1>
    <% if (guest.status === 'yes') { %>
      <p>Votre présence est confirmée pour <strong><%= guest.attending_count %> personne(s)</strong>. <%= coupleNames(w) %> ont hâte de vous accueillir !</p>
      <div style="background:#18130d;color:#fff;border:2px solid #c89d3c;border-radius:14px;padding:.85rem 1rem;margin:1rem 0;text-align:center">
        <div style="font-size:.72rem;text-transform:uppercase;letter-spacing:.12em;color:#c89d3c;font-weight:700">Votre place assise</div>
        <div style="font:700 1.2rem/1.3 Inter,sans-serif;color:#f3d486;margin-top:.25rem">
          🪑 <%= guest.table_name ? guest.table_name : 'Table attribuée par les mariés' %>
        </div>
        <% if (guest.seat_numbers) { %>
          <div style="font-size:.86rem;color:#d9c398;margin-top:.15rem">Siège(s) n° <strong><%= guest.seat_numbers %></strong></div>
        <% } %>
      </div>
      <a class="btn btn-gold btn-block" href="/i/<%= w.slug %>/pass/<%= guest.token %>">🎟️ Voir mon Pass QR (Nom + Table)</a>
      <a class="btn btn-outline btn-block" href="/i/<%= w.slug %>/calendar.ics">📅 Ajouter à mon agenda</a>
    <% } else { %>
      <p>Nous transmettons votre message à <%= coupleNames(w) %>. Votre place a été libérée pour leur plan de table. Vous pouvez toujours leur faire plaisir via la cagnotte.</p>
    <% } %>
    <% if (w.couple_phone) { %>
      <a class="btn btn-whatsapp btn-block" target="_blank" rel="noopener"
         href="<%= waLink(w.couple_phone, (guest.status === 'yes' ? '🎉 Bonjour, c\'est ' + guest.name + ' ! Je viens de confirmer ma présence (' + guest.attending_count + ' pers.' + (guest.table_name ? ' — ' + guest.table_name : '') + ') à votre mariage. Félicitations !' : 'Bonjour, c\'est ' + guest.name + '. Je ne pourrai malheureusement pas être présent(e), mais je vous souhaite tout le bonheur du monde ! 💐')) %>">
        Prévenir les mariés sur WhatsApp
      </a>
    <% } %>
    <% if (w.cagnotte_enabled) { %><a class="btn btn-outline btn-block" href="/i/<%= w.slug %>?g=<%= guest.token %>#cagnotte">🎁 Participer à la cagnotte</a><% } %>
    <p style="margin-top:1rem"><a class="link" href="/i/<%= w.slug %>?g=<%= guest.token %>">← Retour au faire-part</a></p>
  </div>
</main></body></html>
