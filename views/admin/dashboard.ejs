<%- include('../partials/head', { title: 'Tableau de bord', noindex: true }) %>
<%- include('../partials/admin-nav') %>
<div class="container page admin-page">
  <% if (flash) { %><div class="flash"><i class="fa-solid fa-circle-check"></i> <%= flash %></div><% } %>


  <div class="kpi-grid">
    <div class="kpi-card highlight">
      <span class="kpi-label"><i class="fa-solid fa-coins"></i> CA Encaissé</span>
      <b class="kpi-num"><%= fmtMoney(kpi.cashed) %></b>
      <span class="kpi-sub"><%= kpi.published || 0 %> contrat(s) en ligne</span>
    </div>
    <div class="kpi-card">
      <span class="kpi-label"><i class="fa-solid fa-clock"></i> En attente</span>
      <b class="kpi-num"><%= fmtMoney(kpi.pending) %></b>
      <span class="kpi-sub"><%= (kpi.total || 0) - (kpi.published || 0) %> brouillon(s)</span>
    </div>
    <div class="kpi-card">
      <span class="kpi-label"><i class="fa-solid fa-gift"></i> Cagnottes reçues</span>
      <b class="kpi-num"><%= fmtMoney(kpi.cagnotte) %></b>
      <span class="kpi-sub">Frais : <%= fmtMoney(kpi.cagFees) %></span>
    </div>
    <div class="kpi-card">
      <span class="kpi-label"><i class="fa-solid fa-handshake"></i> Com. Partenaires</span>
      <b class="kpi-num"><%= fmtMoney(kpi.commissions) %></b>
      <span class="kpi-sub">À reverser couples : <%= fmtMoney(kpi.toPay) %></span>
    </div>
  </div>

  <% const newLeads = leads.filter(l => l.status === 'new'); %>
  <div class="section-h" id="leads">
    <h2><i class="fa-solid fa-inbox" style="color:var(--gold)"></i> Commandes entrantes <% if (newLeads.length) { %><span class="badge b-new"><%= newLeads.length %></span><% } %></h2>
  </div>

  <% if (!leads.length) { %>
    <div class="card empty-card"><p class="muted">Aucune commande pour l'instant. Votre lien public : <code><%= baseUrl %></code></p></div>
  <% } else { %>
    <div class="mobile-cards-list">
      <% leads.forEach(function(l) { %>
        <div class="admin-item-card">
          <div class="admin-item-header">
            <div>
              <h3 class="admin-item-title"><%= l.bride %> &amp; <%= l.groom %></h3>
              <span class="admin-item-meta"><i class="fa-solid fa-calendar-day"></i> <%= l.event_date ? fmtDate(l.event_date, { weekday: undefined }) : 'Date non fixée' %> <%= l.city ? '· ' + l.city : '' %></span>
            </div>
            <span class="badge b-<%= l.status %>"><%= { new: 'Nouveau', contacted: 'Contacté', won: 'Gagné', lost: 'Perdu' }[l.status] %></span>
          </div>

          <div class="admin-item-body">
            <div><span class="meta-label">Formule :</span> <strong><%= (PLANS[l.plan] || {}).name || l.plan %></strong></div>
            <div><span class="meta-label">WhatsApp :</span> <%= prettyPhone(l.phone) %></div>
            <% if (l.partner) { %><div><span class="meta-label">Apporteur :</span> <%= l.partner %></div><% } %>
          </div>

          <div class="admin-item-footer">
            <form class="inline" method="post" action="/admin/leads/<%= l.id %>/status">
              <select name="status" onchange="this.form.requestSubmit ? this.form.requestSubmit() : this.form.submit()" class="status-select">
                <% ['new', 'contacted', 'won', 'lost'].forEach(function(s) { %><option value="<%= s %>" <%= l.status === s ? 'selected' : '' %>><%= { new: 'Nouveau', contacted: 'Contacté', won: 'Gagné', lost: 'Perdu' }[s] %></option><% }) %>
              </select>
            </form>
            <div class="admin-item-actions">
              <a class="btn btn-wa btn-sm" target="_blank" href="<%= waLink(l.phone, 'Bonjour ' + l.bride + ' & ' + l.groom + ' 💍 Ici ' + brand + ' ! Merci pour votre commande. Votre aperçu est prêt : ' + baseUrl + '/i/' + ((weddings.find(w => w.id === l.wedding_id) || {}).slug || '') + '\nQue souhaitez-vous ajuster avant publication ?') %>"><i class="fa-brands fa-whatsapp"></i> Contacter</a>
              <% if (l.wedding_id) { %><a class="btn btn-outline btn-sm" href="/admin/mariages/<%= l.wedding_id %>"><i class="fa-solid fa-pen-to-square"></i></a><% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>

  <div class="section-h">
    <h2><i class="fa-solid fa-envelope-open" style="color:var(--gold)"></i> Faire-part (<%= weddings.length %>)</h2>
    <a class="btn btn-gold btn-sm" href="/admin/mariages/new"><i class="fa-solid fa-plus"></i> Nouveau</a>
  </div>

  <div class="mobile-cards-list">
    <% weddings.forEach(function(w) { %>
      <div class="admin-item-card">
        <div class="admin-item-header">
          <div>
            <h3 class="admin-item-title"><a href="/admin/mariages/<%= w.id %>"><%= coupleNames(w) %></a></h3>
            <span class="admin-item-meta"><i class="fa-solid fa-calendar-day"></i> <%= w.event_date ? fmtDate(w.event_date, { weekday: undefined }) : 'Date à définir' %></span>
          </div>
          <div class="row" style="gap:.3rem">
            <span class="badge b-<%= w.status %>"><%= { draft: 'Brouillon', published: 'En ligne', archived: 'Archivé' }[w.status] %></span>
            <span class="badge <%= w.paid ? 'b-paid' : 'b-pending' %>"><%= w.paid ? 'Payé' : 'À payer' %></span>
          </div>
        </div>

        <div class="admin-item-stats">
          <div class="stat-box">
            <span class="sb-num"><%= fmtMoney(w.price) %></span>
            <span class="sb-label">Tarif (<%= (PLANS[w.plan] || {}).name %>)</span>
          </div>
          <div class="stat-box">
            <span class="sb-num"><%= w.s.guests.yes %></span>
            <span class="sb-label">Confirmés (<%= w.s.guests.people %> pers.)</span>
          </div>
          <div class="stat-box">
            <span class="sb-num"><%= fmtMoney(w.s.cagnotte.total) %></span>
            <span class="sb-label">Cagnotte</span>
          </div>
          <div class="stat-box">
            <span class="sb-num"><%= w.views %></span>
            <span class="sb-label">Vues</span>
          </div>
        </div>

        <div class="admin-item-footer">
          <span class="small muted"><%= w.partner ? 'Partenaire: ' + w.partner : 'Direct' %></span>
          <div class="admin-item-actions">
            <a class="btn btn-outline btn-sm" target="_blank" href="/i/<%= w.slug %>"><i class="fa-regular fa-eye"></i> Faire-part</a>
            <a class="btn btn-outline btn-sm" href="/espace/<%= w.slug %>"><i class="fa-solid fa-users-gear"></i> Espace</a>
            <a class="btn btn-gold btn-sm" href="/admin/mariages/<%= w.id %>"><i class="fa-solid fa-pen"></i> Gérer</a>
          </div>
        </div>
      </div>
    <% }) %>
  </div>

  <% if (partners.length) { %>
    <div class="section-h"><h2><i class="fa-solid fa-handshake" style="color:var(--gold)"></i> Partenaires</h2></div>
    <div class="mobile-cards-list">
      <% partners.forEach(function(p) { %>
        <div class="admin-item-card">
          <div class="admin-item-header">
            <strong><%= p.partner %></strong>
            <span class="badge b-won"><%= p.n %> contrat(s)</span>
          </div>
          <div class="row between" style="margin-top:.4rem">
            <span class="small muted">Payés : <%= p.paid %></span>
            <span class="small">Commission due : <strong><%= fmtMoney(p.due) %></strong></span>
          </div>
        </div>
      <% }) %>
    </div>
    <div class="card" style="margin-top:1rem;padding:1rem;background:#fff">
      <small class="muted"><i class="fa-solid fa-link"></i> Lien de parrainage :<br><code style="word-break:break-all"><%= baseUrl %>/?ref=NomDuPartenaire#commander</code></small>
    </div>
  <% } %>
</div>
<script src="/static/js/seamless.js?v=8.0" defer></script>
</body></html>
