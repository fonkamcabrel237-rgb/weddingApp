<%- include('../partials/head', { title: w ? coupleNames(w) : 'Nouveau faire-part', noindex: true }) %>
<%- include('../partials/admin-nav') %>
<% const v = (k, d) => (w && w[k] != null ? w[k] : (d || '')); %>
<div class="container page admin-page">
  <% if (flash) { %><div class="flash"><i class="fa-solid fa-circle-check"></i> <%= flash %></div><% } %>

  <div class="form-header-bar">
    <div>
      <a href="/admin" class="back-link"><i class="fa-solid fa-arrow-left"></i> Retour au tableau de bord</a>
      <h1 class="form-title"><%= w ? coupleNames(w) : 'Nouveau faire-part' %></h1>
    </div>
    <% if (w) { %>
      <div class="form-header-badges">
        <span class="badge b-<%= w.status %>"><%= { draft: 'Brouillon', published: 'En ligne', archived: 'Archivé' }[w.status] %></span>
        <span class="badge <%= w.paid ? 'b-paid' : 'b-pending' %>"><%= w.paid ? 'Payé' : 'Non payé' %></span>
      </div>
    <% } %>
  </div>

  <% if (w) { %>
  <!-- Barre d'actions rapides & liens -->
  <div class="admin-quick-actions">
    <div class="card action-subcard">
      <div class="copybox-group">
        <span class="meta-label"><i class="fa-solid fa-link"></i> Lien public de l'invitation</span>
        <div class="copybox">
          <input readonly value="<%= inviteUrl(w) %>" onclick="this.select()">
          <a class="btn btn-sm btn-outline" target="_blank" href="/i/<%= w.slug %>"><i class="fa-regular fa-eye"></i></a>
          <a class="btn btn-sm btn-outline" href="/i/<%= w.slug %>/qr.png?size=1000" download title="Télécharger QR"><i class="fa-solid fa-qrcode"></i></a>
        </div>
      </div>
      <div class="copybox-group" style="margin-top:0.6rem">
        <span class="meta-label"><i class="fa-solid fa-key"></i> Accès espace privé mariés</span>
        <div class="copybox">
          <input readonly value="<%= baseUrl %>/espace/<%= w.slug %>?k=<%= w.access_key %>" onclick="this.select()">
          <a class="btn btn-sm btn-outline" target="_blank" href="/espace/<%= w.slug %>"><i class="fa-solid fa-users-gear"></i></a>
          <% if (w.couple_phone) { %>
            <a class="btn btn-sm btn-wa" target="_blank" href="<%= waLink(w.couple_phone, 'Félicitations ' + coupleNames(w) + ' 🎉 Votre faire-part est prêt : ' + inviteUrl(w) + '\n\nVotre espace mariés pour gérer vos invités et voir la cagnotte : ' + baseUrl + '/espace/' + w.slug + '?k=' + w.access_key) %>"><i class="fa-brands fa-whatsapp"></i></a>
          <% } %>
        </div>
      </div>
    </div>

    <div class="card action-subcard">
      <div class="cagnotte-pill">
        <span class="meta-label">Cagnotte collectée</span>
        <strong><%= fmtMoney(s.cagnotte.total) %></strong>
        <span class="small muted">Net à reverser : <%= fmtMoney(s.cagnotte.net) %> (frais <%= fmtMoney(s.cagnotte.fee) %>)</span>
      </div>
      <form class="action-btn-row" method="post" action="/admin/mariages/<%= w.id %>/action">
        <button class="btn btn-sm <%= w.paid ? 'btn-outline' : 'btn-gold' %>" name="action" value="paid"><i class="fa-solid fa-money-bill-wave"></i> <%= w.paid ? 'Marquer impayé' : 'Marquer payé' %></button>
        <% if (w.status !== 'published') { %>
          <button class="btn btn-sm btn-gold" name="action" value="publish"><i class="fa-solid fa-rocket"></i> Publier</button>
        <% } else { %>
          <button class="btn btn-outline btn-sm" name="action" value="draft"><i class="fa-solid fa-eye-slash"></i> Dépublier</button>
        <% } %>
        <button class="btn btn-outline btn-sm" name="action" value="payout"><i class="fa-solid fa-hand-holding-dollar"></i> <%= w.payout_done ? 'Non reversé' : 'Reversé' %></button>
        <button class="btn btn-outline btn-sm" name="action" value="archive"><i class="fa-solid fa-box-archive"></i> Archiver</button>
        <button class="btn btn-danger btn-sm" name="action" value="delete" onclick="return confirm('Supprimer définitivement ce faire-part et toutes ses données ?')"><i class="fa-solid fa-trash-can"></i></button>
      </form>
    </div>
  </div>
  <% } %>

  <form method="post" action="<%= w ? '/admin/mariages/' + w.id : '/admin/mariages' %>" class="admin-edit-form">
    <!-- SECTION 1 -->
    <div class="form-section-card">
      <div class="form-section-title"><i class="fa-solid fa-heart" style="color:var(--gold)"></i> Les Mariés & Identité</div>
      <div class="grid g3">
        <label>Prénom de la mariée *<input name="bride" required value="<%= v('bride') %>" placeholder="Grâce"></label>
        <label>Prénom du marié *<input name="groom" required value="<%= v('groom') %>" placeholder="Junior"></label>
        <label>Identifiant du lien (/i/…)<input name="slug" value="<%= v('slug') %>" placeholder="grace-et-junior"></label>
      </div>
      <div class="grid g3">
        <label>WhatsApp du couple<input name="couple_phone" value="<%= w && w.couple_phone ? prettyPhone(w.couple_phone) : '' %>" placeholder="657664546"></label>
        <label>Email du couple<input name="couple_email" type="email" value="<%= v('couple_email') %>" placeholder="couple@email.com"></label>
        <label>Célébration
          <select name="event_type"><% [['mariage', 'Mariage'], ['dot', 'Dot traditionnelle'], ['mariage_dot', 'Dot + Mariage']].forEach(function([k, l]) { %><option value="<%= k %>" <%= v('event_type', 'mariage') === k ? 'selected' : '' %>><%= l %></option><% }) %></select>
        </label>
      </div>
      <label>Phrase d'accroche principale<input name="headline" value="<%= v('headline', 'Nous nous disons OUI !') %>"></label>
      <label>Leur histoire (un paragraphe par saut de ligne)<textarea name="story" rows="4" placeholder="Racontez leur rencontre, leur cheminement..."><%= v('story') %></textarea></label>
      <div class="grid g3">
        <label>Hashtag officiel<input name="hashtag" value="<%= v('hashtag') %>" placeholder="GraceJunior2026"></label>
        <label>Thème visuel
          <select name="theme" id="themeSelect"><% Object.entries(THEMES).forEach(function([k, t]) { %><option value="<%= k %>" <%= v('theme', 'royal') === k ? 'selected' : '' %>><%= t %></option><% }) %></select>
        </label>
        <label>Musique de fond (.mp3 URL)<input name="music_url" value="<%= v('music_url') %>" placeholder="https://…/musique.mp3"></label>
      </div>

      <!-- Configurateur de Palette Sur-Mesure (affiché quand Thème = custom) -->
      <div id="customThemeBox" class="custom-theme-box" style="display:<%= v('theme', 'royal') === 'custom' ? 'block' : 'none' %>">
        <div class="ct-head">
          <strong><i class="fa-solid fa-palette" style="color:var(--gold)"></i> Palette sur-mesure des mariés</strong>
          <span class="small muted">Choisissez une palette prédéfinie ou entrez les 2 couleurs du mariage : le système calcule automatiquement les dégradés et le contraste.</span>
        </div>

        <div class="ct-presets">
          <% CUSTOM_PALETTES.forEach(function(pal) { %>
            <button type="button" class="ct-preset-chip" data-bg="<%= pal.bg %>" data-accent="<%= pal.accent %>">
              <span class="ct-dots">
                <i style="background:<%= pal.bg %>"></i>
                <i style="background:<%= pal.accent %>"></i>
              </span>
              <span><%= pal.name %></span>
            </button>
          <% }) %>
        </div>

        <div class="ct-pickers">
          <label>Couleur Principale / Accent (Boutons, Sceau, Ornement)
            <div class="ct-color-row">
              <input type="color" id="pickerAccent" value="<%= v('custom_accent', '#b8913f') %>">
              <input type="text" name="custom_accent" id="hexAccent" value="<%= v('custom_accent', '#b8913f') %>" maxlength="7" placeholder="#b8913f">
            </div>
          </label>
          <label>Couleur de Fond / Ambiance (Fond de l'invitation)
            <div class="ct-color-row">
              <input type="color" id="pickerBg" value="<%= v('custom_bg', '#faf6f0') %>">
              <input type="text" name="custom_bg" id="hexBg" value="<%= v('custom_bg', '#faf6f0') %>" maxlength="7" placeholder="#faf6f0">
            </div>
          </label>
        </div>

        <div class="ct-preview" id="ctPreview">
          <div class="ct-preview-seal" id="ctPreviewSeal"><%= (v('bride', 'G').charAt(0) + '&' + v('groom', 'J').charAt(0)).toUpperCase() %></div>
          <div class="ct-preview-info">
            <div class="ct-preview-title" id="ctPreviewTitle"><%= v('bride', 'Grâce') %> &amp; <%= v('groom', 'Junior') %></div>
            <div class="ct-preview-sub" id="ctPreviewSub">Aperçu automatique du contraste et des boutons</div>
          </div>
          <span class="ct-preview-btn" id="ctPreviewBtn">Confirmer</span>
        </div>
      </div>
    </div>

    <!-- SECTION 2 -->
    <div class="form-section-card">
      <div class="form-section-title"><i class="fa-solid fa-map-location-dot" style="color:var(--gold)"></i> Date, Cérémonie & Lieux</div>
      <div class="grid g3">
        <label>Date et heure principale (Heure de Douala)<input type="datetime-local" name="event_date" value="<%= v('event_date') %>"></label>
        <label>Date limite de réponse RSVP<input type="date" name="rsvp_deadline" value="<%= v('rsvp_deadline') %>"></label>
        <label>Dress code souhaité<input name="dress_code" value="<%= v('dress_code') %>" placeholder="Tenue traditionnelle / Blanc & Or"></label>
      </div>
      <div class="grid g3">
        <label>Nom du lieu / Salle<input name="venue_name" value="<%= v('venue_name') %>" placeholder="Akwa Palace"></label>
        <label>Quartier / Rue<input name="venue_address" value="<%= v('venue_address') %>" placeholder="Boulevard de la Liberté"></label>
        <label>Ville<input name="city" value="<%= v('city') %>" placeholder="Douala"></label>
      </div>
      <label>Recherche Google Maps (nom exact ou coordonnées GPS ex: « 4.0511, 9.7679 »)
        <input name="maps_query" value="<%= v('maps_query') %>" placeholder="Laissez vide pour utiliser automatique: Salle + Adresse + Ville">
      </label>
    </div>

    <!-- SECTION 3 -->
    <div class="form-section-card">
      <div class="form-section-title"><i class="fa-solid fa-timeline" style="color:var(--gold)"></i> Déroulement du Programme</div>
      <p class="small muted" style="margin-top:0">Renseignez les étapes clés (Dot, Mairie, Bénédiction nuptiale, Soirée dansante...)</p>
      <div class="program-grid">
        <% for (let i = 0; i < 5; i++) { const p = program[i] || {}; %>
          <div class="program-item-card">
            <span class="program-step-badge">Étape <%= i + 1 %></span>
            <div class="grid g2" style="gap:0.5rem">
              <input name="program[<%= i %>][title]" value="<%= p.title || '' %>" placeholder="Titre (ex: Bénédiction)">
              <input type="datetime-local" name="program[<%= i %>][date]" value="<%= p.date || '' %>">
              <input name="program[<%= i %>][place]" value="<%= p.place || '' %>" placeholder="Lieu (ex: Chapelle EPC)">
              <input name="program[<%= i %>][address]" value="<%= p.address || '' %>" placeholder="Adresse / Quartier">
            </div>
          </div>
        <% } %>
      </div>
    </div>

    <!-- SECTION 4 -->
    <div class="form-section-card">
      <div class="form-section-title"><i class="fa-solid fa-mobile-screen-button" style="color:var(--gold)"></i> Cagnotte MoMo / Orange Money</div>
      <label class="checkbox-label"><input type="checkbox" name="cagnotte_enabled" value="1" <%= !w || w.cagnotte_enabled ? 'checked' : '' %>> <strong>Activer la cagnotte sur le faire-part</strong></label>
      <div class="grid g3" style="margin-top:0.8rem">
        <label>Objectif visé (FCFA)<input name="cagnotte_goal" inputmode="numeric" value="<%= v('cagnotte_goal') || '' %>" placeholder="1 000 000"></label>
        <label>N° MTN Mobile Money<input name="momo_number" value="<%= w && w.momo_number ? prettyPhone(w.momo_number) : '' %>" placeholder="670000000"></label>
        <label>Nom du compte MoMo<input name="momo_name" value="<%= v('momo_name') %>" placeholder="Junior Manga"></label>
      </div>
      <div class="grid g2">
        <label>N° Orange Money<input name="om_number" value="<%= w && w.om_number ? prettyPhone(w.om_number) : '' %>" placeholder="690000000"></label>
        <label>Nom du compte OM<input name="om_name" value="<%= v('om_name') %>" placeholder="Grâce Ngo"></label>
      </div>
      <label>Message de la cagnotte<textarea name="cagnotte_text" rows="2"><%= v('cagnotte_text') %></textarea></label>
    </div>

    <!-- SECTION 5 -->
    <div class="form-section-card">
      <div class="form-section-title"><i class="fa-solid fa-file-invoice-dollar" style="color:var(--gold)"></i> Données Commerciales & Partenaires</div>
      <div class="grid g4">
        <label>Formule souscrite
          <select name="plan"><% Object.entries(PLANS).forEach(function([k, p]) { %><option value="<%= k %>" <%= v('plan', 'prestige') === k ? 'selected' : '' %>><%= p.name %></option><% }) %></select>
        </label>
        <label>Montant facturé (FCFA)<input name="price" inputmode="numeric" value="<%= v('price', 50000) %>"></label>
        <label>Partenaire apporteur<input name="partner" value="<%= v('partner') %>" placeholder="Nom du wedding planner"></label>
        <label>Commission due (FCFA)<input name="partner_commission" inputmode="numeric" value="<%= v('partner_commission', 0) %>"></label>
      </div>
    </div>

    <!-- Boutons d'action flottants sticky -->
    <div class="form-floating-bar">
      <a class="btn btn-outline form-cancel-btn" href="/admin">Annuler</a>
      <button class="btn btn-gold form-save-btn"><i class="fa-solid fa-floppy-disk"></i> Enregistrer</button>
    </div>
  </form>

  <% if (w) { %>
  <!-- Galerie photos -->
  <div class="form-section-card" id="photos" style="margin-top:1.5rem">
    <div class="form-section-title"><i class="fa-solid fa-images" style="color:var(--gold)"></i> Galerie Photos (<%= photos.length %>)</div>
    <form method="post" action="/admin/mariages/<%= w.id %>/photos" enctype="multipart/form-data" class="upload-bar">
      <input type="file" name="photos" accept="image/*" multiple required class="file-input">
      <button class="btn btn-gold btn-sm"><i class="fa-solid fa-upload"></i> Ajouter les photos</button>
    </form>
    <div class="photos-admin-grid">
      <% photos.forEach(function(p) { %>
        <div class="photo-admin-card <%= w.cover_photo === p.filename ? 'is-cover' : '' %>">
          <img src="/uploads/<%= p.filename %>" loading="lazy" alt="Photo mariage">
          <div class="photo-admin-overlay">
            <form method="post" action="/admin/mariages/<%= w.id %>/photos/<%= p.id %>" class="inline">
              <button name="action" value="cover" class="badge-cover-btn" title="Définir comme photo principale"><%= w.cover_photo === p.filename ? '★ Principale' : '☆ Définir' %></button>
              <button name="action" value="delete" class="badge-delete-btn" onclick="return confirm('Supprimer cette photo ?')" title="Supprimer"><i class="fa-solid fa-trash"></i></button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
  <% } %>
</div>
<script>
  (function () {
    var sel = document.getElementById('themeSelect');
    var box = document.getElementById('customThemeBox');
    var pAcc = document.getElementById('pickerAccent');
    var hAcc = document.getElementById('hexAccent');
    var pBg = document.getElementById('pickerBg');
    var hBg = document.getElementById('hexBg');
    var prev = document.getElementById('ctPreview');
    var seal = document.getElementById('ctPreviewSeal');
    var title = document.getElementById('ctPreviewTitle');
    var sub = document.getElementById('ctPreviewSub');
    var btn = document.getElementById('ctPreviewBtn');

    function lum(hex) {
      var h = (hex || '#000000').replace('#', '');
      if (h.length !== 6) return 0.5;
      var rgb = [parseInt(h.slice(0,2),16), parseInt(h.slice(2,4),16), parseInt(h.slice(4,6),16)].map(function(v){
        var s = v / 255;
        return s <= 0.03928 ? s / 12.92 : Math.pow((s + 0.055) / 1.055, 2.4);
      });
      return 0.2126 * rgb[0] + 0.7152 * rgb[1] + 0.0722 * rgb[2];
    }

    function updatePreview() {
      var bg = /^#[0-9a-fA-F]{6}$/.test(hBg.value) ? hBg.value : '#faf6f0';
      var acc = /^#[0-9a-fA-F]{6}$/.test(hAcc.value) ? hAcc.value : '#b8913f';
      var dark = lum(bg) < 0.35;
      var btnTxt = lum(acc) > 0.42 ? '#18130d' : '#ffffff';
      prev.style.background = bg;
      prev.style.borderColor = acc;
      title.style.color = dark ? '#f5f0e6' : '#221b16';
      sub.style.color = dark ? '#c2b8a8' : '#6e6359';
      seal.style.background = acc;
      seal.style.color = btnTxt;
      btn.style.background = acc;
      btn.style.color = btnTxt;
    }

    if (sel && box) {
      sel.addEventListener('change', function () {
        box.style.display = sel.value === 'custom' ? 'block' : 'none';
      });
    }
    if (pAcc && hAcc) {
      pAcc.addEventListener('input', function () { hAcc.value = pAcc.value; updatePreview(); });
      hAcc.addEventListener('input', function () { if (/^#[0-9a-fA-F]{6}$/.test(hAcc.value)) { pAcc.value = hAcc.value; updatePreview(); } });
    }
    if (pBg && hBg) {
      pBg.addEventListener('input', function () { hBg.value = pBg.value; updatePreview(); });
      hBg.addEventListener('input', function () { if (/^#[0-9a-fA-F]{6}$/.test(hBg.value)) { pBg.value = hBg.value; updatePreview(); } });
    }
    document.querySelectorAll('.ct-preset-chip').forEach(function (chip) {
      chip.addEventListener('click', function () {
        pBg.value = hBg.value = chip.dataset.bg;
        pAcc.value = hAcc.value = chip.dataset.accent;
        updatePreview();
      });
    });
    if (prev) updatePreview();
  })();
</script>
</body></html>
