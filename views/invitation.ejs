<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <% const names = coupleNames(w); const title = (guest ? guest.name + ', ' : '') + names + ' vous invitent'; const venueQuery = w.maps_query || [w.venue_name, w.venue_address, w.city].filter(Boolean).join(', '); %>
  <title><%= names %> — <%= w.event_type === 'dot' ? 'Dot' : 'Mariage' %></title>
  <meta name="description" content="<%= w.event_date ? fmtDate(w.event_date) : '' %><%= w.city ? ' · ' + w.city : '' %> — Confirmez votre présence en ligne.">
  <meta property="og:type" content="website">
  <meta property="og:title" content="💍 <%= title %>">
  <meta property="og:description" content="<%= w.event_date ? fmtDate(w.event_date) : '' %><%= w.city ? ' · ' + w.city : '' %> — Ouvrez votre faire-part et confirmez votre présence.">
  <meta property="og:url" content="<%= inviteUrl(w, guest) %>">
  <% if (w.cover_photo) { %><meta property="og:image" content="<%= baseUrl %>/uploads/<%= w.cover_photo %>"><% } %>
  <% if (isDraft) { %><meta name="robots" content="noindex"><% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Great+Vibes&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link rel="stylesheet" href="/static/css/invite.css?v=11.0">
</head>
<body class="theme-<%= w.theme || 'royal' %>" <% if (w.theme === 'custom') { %>style="<%= customThemeStyle(w) %>"<% } %>>

<% if (isDraft) { %>
  <div class="draft-banner">👀 Aperçu privé — ce faire-part n'est pas encore publié. <a href="/espace/<%= w.slug %>">Espace mariés</a></div>
<% } %>

<!-- Enveloppe d'ouverture -->
<div class="envelope" id="envelope">
  <div class="envelope-inner">
    <p class="small-caps">Vous êtes invité<%= guest ? '' : '(e)' %></p>
    <% if (guest) { %><p class="guest-name"><%= guest.name %></p><% } %>
    <div class="seal"><span><%= w.bride.charAt(0) %>&amp;<%= w.groom.charAt(0) %></span></div>
    <h1 class="script"><%= names %></h1>
    <button class="btn btn-gold" id="openEnvelope">Ouvrir l'invitation</button>
  </div>
</div>

<main id="top">
  <!-- HERO -->
  <header class="hero" <% if (w.cover_photo) { %>style="--cover:url('/uploads/<%= w.cover_photo %>')"<% } %>>
    <div class="hero-overlay"></div>
    <div class="hero-content reveal">
      <p class="small-caps"><%= w.headline || 'Nous nous disons OUI !' %></p>
      <h1 class="script names"><span><%= w.bride %></span><em>&amp;</em><span><%= w.groom %></span></h1>
      <% if (w.event_date) { %>
        <p class="hero-date"><%= fmtDate(w.event_date) %></p>
        <p class="hero-place"><%= [w.venue_name, w.city].filter(Boolean).join(' · ') %></p>
        <div class="countdown" data-date="<%= parseLocal(w.event_date).toISOString() %>">
          <div><b data-u="d">0</b><span>jours</span></div>
          <div><b data-u="h">0</b><span>heures</span></div>
          <div><b data-u="m">0</b><span>min</span></div>
          <div><b data-u="s">0</b><span>sec</span></div>
        </div>
      <% } %>
      <a href="#rsvp" class="btn btn-gold">Confirmer ma présence</a>
    </div>
    <% if (w.music_url) { %>
      <button class="music-btn" id="musicBtn" aria-label="Musique">♫</button>
      <audio id="music" src="<%= w.music_url %>" loop preload="auto" playsinline></audio>
    <% } %>
  </header>

  <% if (guest) { %>
  <section class="section personal reveal">
    <p class="script big">Cher(e) <%= guest.name %>,</p>
    <p>Votre présence à nos côtés rendra ce jour encore plus beau.
      <% if (guest.seats > 1) { %>Cette invitation est valable pour <strong><%= guest.seats %> personnes</strong>.<% } else { %>Cette invitation vous est personnellement adressée.<% } %>
      <% if (guest.table_name) { %><br>🪑 Table réservée : <strong><%= guest.table_name %></strong><% if (guest.seat_numbers) { %> (Siège(s) <%= guest.seat_numbers %>)<% } %>.<% } %>
    </p>
  </section>
  <% } %>

  <% if (w.story) { %>
  <section class="section story reveal">
    <h2 class="section-title">Notre histoire</h2>
    <div class="ornament">❦</div>
    <% w.story.split(/\n+/).forEach(function(p) { %><p><%= p %></p><% }) %>
    <% if (w.hashtag) { %><p class="hashtag">#<%= w.hashtag.replace(/^#/, '') %></p><% } %>
  </section>
  <% } %>

  <!-- PROGRAMME -->
  <section class="section program reveal" id="programme">
    <h2 class="section-title">Le programme</h2>
    <div class="ornament">❦</div>
    <% const items = program.length ? program : (w.event_date ? [{ title: w.event_type === 'dot' ? 'Cérémonie de la dot' : 'Célébration', date: w.event_date, place: w.venue_name, address: [w.venue_address, w.city].filter(Boolean).join(', ') }] : []); %>
    <div class="timeline">
      <% items.forEach(function(it) { %>
        <div class="tl-item">
          <div class="tl-dot"></div>
          <div class="tl-card">
            <h3><%= it.title %></h3>
            <% if (it.date) { %><p class="tl-date"><i class="fa-regular fa-clock"></i> <%= fmtDate(it.date) %><% if (it.date.length > 10) { %> · <%= fmtTime(it.date) %><% } %></p><% } %>
            <% if (it.place) { %><p class="tl-place"><i class="fa-solid fa-location-dot"></i> <%= it.place %></p><% } %>
            <% if (it.address) { %><p class="muted"><%= it.address %></p>
              <a class="link" target="_blank" rel="noopener" href="<%= mapsDirections([it.place, it.address].filter(Boolean).join(', ')) %>"><i class="fa-solid fa-diamond-turn-right"></i> Itinéraire GPS</a><% } %>
          </div>
        </div>
      <% }) %>
    </div>
    <% if (w.dress_code) { %>
      <div class="dress"><span class="small-caps"><i class="fa-solid fa-shirt"></i> Dress code</span><p><%= w.dress_code %></p></div>
    <% } %>
  </section>

  <!-- LIEU -->
  <% if (venueQuery) { %>
  <section class="section venue reveal" id="lieu">
    <h2 class="section-title">Le lieu</h2>
    <div class="ornament">❦</div>
    <p class="venue-name"><i class="fa-solid fa-champagne-glasses" style="color:var(--accent)"></i> <%= w.venue_name %></p>
    <p class="muted"><%= [w.venue_address, w.city].filter(Boolean).join(', ') %></p>
    <div class="map"><iframe loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="<%= mapsEmbed(venueQuery) %>" title="Carte"></iframe></div>
    <div class="btn-row">
      <a class="btn btn-gold" target="_blank" rel="noopener" href="<%= mapsDirections(venueQuery) %>"><i class="fa-solid fa-map-location-dot"></i> Google Maps</a>
      <a class="btn btn-outline" target="_blank" rel="noopener" href="https://waze.com/ul?q=<%= encodeURIComponent(venueQuery) %>&navigate=yes"><i class="fa-brands fa-waze"></i> Waze</a>
      <a class="btn btn-outline" href="/i/<%= w.slug %>/calendar.ics"><i class="fa-regular fa-calendar-plus"></i> Agenda</a>
    </div>
  </section>
  <% } %>

  <!-- GALERIE -->
  <% if (photos.length) { %>
  <section class="section gallery-section reveal" id="galerie">
    <h2 class="section-title">Nos souvenirs</h2>
    <div class="ornament">❦</div>
    <div class="gallery">
      <% photos.forEach(function(p, i) { %>
        <button class="g-item" data-src="/uploads/<%= p.filename %>" aria-label="Photo <%= i + 1 %>"><img loading="lazy" src="/uploads/<%= p.filename %>" alt=""></button>
      <% }) %>
    </div>
  </section>
  <% } %>

  <!-- RSVP -->
  <section class="section rsvp reveal" id="rsvp">
    <h2 class="section-title">Serez-vous des nôtres ?</h2>
    <div class="ornament">❦</div>
    <% if (w.rsvp_deadline) { %><p class="muted">Merci de répondre avant le <strong><%= fmtDate(w.rsvp_deadline, { weekday: undefined }) %></strong></p><% } %>
    <% if (error === 'name') { %><p class="alert">Merci d'indiquer votre nom ou votre numéro WhatsApp.</p><% } %>
    <% if (error === 'not_on_list') { %><p class="alert"><i class="fa-solid fa-user-lock"></i> Cette réception se fait sur liste d'invitation nominative. Votre numéro ou nom n'a pas été trouvé dans la liste des places attribuées. Ouvrez le lien personnel reçu sur WhatsApp ou contactez directement les mariés ci-dessous.</p><% } %>
    <% if (error === 'quota_full') { %><p class="alert"><i class="fa-solid fa-chair"></i> Toutes les places assises prévues pour la réception sont complètes. Contactez directement les mariés.</p><% } %>
    <% if (error === 'draft' || isDraft) { %><p class="alert">Les réponses seront ouvertes dès la publication du faire-part.</p><% } %>
    <% if (guest && guest.status !== 'pending') { %>
      <p class="alert ok">Nous avons bien reçu votre réponse : <strong><%= guest.status === 'yes' ? 'présent(e) (' + guest.attending_count + ' pers.)' : 'absent(e)' %></strong><% if (guest.status === 'yes' && guest.table_name) { %> · 🪑 <strong><%= guest.table_name %></strong><% if (guest.seat_numbers) { %> (Siège(s) <%= guest.seat_numbers %>)<% } %><% } %>. Vous pouvez la modifier ci-dessous.
        <% if (guest.status === 'yes') { %><br><a class="link" href="/i/<%= w.slug %>/pass/<%= guest.token %>">🎟️ Voir mon pass d'entrée (Nom + Table)</a><% } %></p>
    <% } %>
    <% if (deadlinePassed && !guest) { %>
      <p class="alert">La date limite de réponse est passée. Contactez directement les mariés.</p>
    <% } else { %>
    <form method="post" action="/i/<%= w.slug %>/rsvp" class="card form">
      <% if (guest) { %><input type="hidden" name="token" value="<%= guest.token %>"><% } %>
      <% if (!guest && w.strict_rsvp) { %>
        <p class="muted" style="font-size:.86rem;margin:0 0 .8rem"><i class="fa-solid fa-shield-halved" style="color:var(--accent)"></i> Indiquez le <strong>numéro WhatsApp</strong> (ou le nom exact) enregistré par les mariés pour confirmer votre place et obtenir votre Pass QR avec votre table.</p>
      <% } %>
      <label>Votre nom complet
        <input name="name" required maxlength="120" value="<%= guest ? guest.name : '' %>" <%= guest && guest.source === 'list' ? 'readonly' : '' %>>
      </label>
      <label>Numéro WhatsApp
        <input name="phone" type="tel" inputmode="tel" placeholder="6XX XX XX XX" value="<%= guest && guest.phone ? prettyPhone(guest.phone) : '' %>">
      </label>
      <div class="choice">
        <label class="radio"><input type="radio" name="attending" value="yes" <%= !guest || guest.status !== 'no' ? 'checked' : '' %>><span>🥂 Je serai présent(e)</span></label>
        <label class="radio"><input type="radio" name="attending" value="no" <%= guest && guest.status === 'no' ? 'checked' : '' %>><span>😢 Je ne pourrai pas venir</span></label>
      </div>
      <label class="count-field">Nombre de personnes (vous inclus)
        <% const max = guest && guest.source === 'list' ? guest.seats : 6; %>
        <select name="count"><% for (let n = 1; n <= max; n++) { %><option <%= guest && guest.attending_count === n ? 'selected' : '' %>><%= n %></option><% } %></select>
      </label>
      <label>Un mot pour les mariés (livre d'or)
        <textarea name="message" rows="3" maxlength="500" placeholder="Vos vœux de bonheur…"><%= guest && guest.message ? guest.message : '' %></textarea>
      </label>
      <button class="btn btn-gold btn-block" <%= isDraft ? 'disabled' : '' %>>Envoyer ma réponse</button>
      <% if (w.couple_phone) { %>
        <a class="btn btn-whatsapp btn-block" target="_blank" rel="noopener" href="<%= waLink(w.couple_phone, 'Bonjour ' + names + ' ! ' + (guest ? 'C\'est ' + guest.name + '. ' : '') + 'Je confirme ma présence à votre mariage 🎉') %>">Répondre directement sur WhatsApp</a>
      <% } %>
    </form>
    <% } %>
  </section>

  <!-- CAGNOTTE DIRECTE USSD (MTN MoMo & Orange Money) -->
  <% if (w.cagnotte_enabled) { %>
  <section class="section cagnotte reveal" id="cagnotte">
    <h2 class="section-title">La cagnotte des mariés</h2>
    <div class="ornament">❦</div>
    <p><%= w.cagnotte_text || 'Votre présence est notre plus beau cadeau. Pour ceux qui le souhaitent, une cagnotte est ouverte pour nous aider à bâtir notre foyer.' %></p>
    <% if (w.cagnotte_goal > 0) { const pct = Math.min(100, Math.round(s.cagnotte.total * 100 / w.cagnotte_goal)); %>
      <div class="progress"><div style="width: <%= pct %>%"></div></div>
      <p class="muted"><strong><%= fmtMoney(s.cagnotte.total) %></strong> collectés sur <%= fmtMoney(w.cagnotte_goal) %> · <%= s.cagnotte.count %> don(s) validé(s)</p>
    <% } %>

    <% if (contribSuccess) { %>
      <div class="card cagnotte-success-card">
        <div class="cagnotte-success-icon"><i class="fa-solid fa-gift"></i></div>
        <h3 style="font-size:1.6rem;margin-bottom:.3rem">Merci de tout cœur !</h3>
        <p>Votre don de <strong><%= fmtMoney(contribSuccess.amount) %></strong> via <strong><%= contribSuccess.provider === 'om' ? 'Orange Money' : 'MTN MoMo' %></strong> a bien été enregistré.</p>
        <p class="small muted" style="margin-top:.3rem">Les mariés en ont été informés et recevront votre tendre message.</p>
        <% if (w.couple_phone) { %>
          <a class="btn btn-whatsapp btn-block" style="margin-top:1rem" target="_blank" rel="noopener" href="<%= waLink(w.couple_phone, 'Bonjour ' + names + ' 💍 ! C\'est ' + (contribSuccess.name || 'un invité') + '. Je viens de vous envoyer un cadeau de ' + fmtMoney(contribSuccess.amount) + ' via ' + (contribSuccess.provider === 'om' ? 'Orange Money' : 'MTN MoMo') + ' pour votre mariage.' + (contribSuccess.message ? ' « ' + contribSuccess.message + ' »' : '') + ' 🎉') %>">
            <i class="fa-brands fa-whatsapp"></i> Informer les mariés sur WhatsApp
          </a>
        <% } %>
      </div>
    <% } %>

    <% if (error === 'amount') { %><p class="alert"><i class="fa-solid fa-triangle-exclamation"></i> Montant minimum : 500 FCFA.</p><% } %>

    <%
      const hasMomo = Boolean(w.momo_number);
      const hasOm = Boolean(w.om_number);
      const defaultOp = hasMomo ? 'momo' : (hasOm ? 'om' : 'momo');
      const momoClean = localPhone(w.momo_number);
      const omClean = localPhone(w.om_number);
    %>

    <% if (!hasMomo && !hasOm) { %>
      <div class="card" style="text-align:center;padding:2rem 1.2rem">
        <i class="fa-solid fa-mobile-screen-button" style="font-size:2rem;color:var(--accent);margin-bottom:.8rem;display:block"></i>
        <p class="muted">Les coordonnées MoMo / Orange Money seront bientôt disponibles.</p>
      </div>
    <% } else { %>
      <div class="card cagnotte-card" id="cagnotteCard"
           data-momo="<%= momoClean %>" data-om="<%= omClean %>"
           data-momo-name="<%= w.momo_name || '' %>" data-om-name="<%= w.om_name || '' %>">

        <!-- Étape 1 : Montant -->
        <div class="cagnotte-step">
          <span class="step-badge">1</span>
          <label class="step-label" for="amount">Choisissez le montant de votre cadeau</label>
        </div>

        <div class="amounts">
          <% [5000, 10000, 25000, 50000].forEach(function(a) { %>
            <button type="button" class="chip <%= a === 10000 ? 'active' : '' %>" data-amount="<%= a %>"><%= fmtMoney(a) %></button>
          <% }) %>
        </div>
        <div class="amount-input-wrap">
          <input name="custom_amount" id="amount" inputmode="numeric" value="10000" placeholder="10 000" required>
          <span class="currency-tag">FCFA</span>
        </div>

        <!-- Étape 2 : Opérateur -->
        <div class="cagnotte-step" style="margin-top:1.4rem">
          <span class="step-badge">2</span>
          <span class="step-label">Choisissez votre opérateur</span>
        </div>

        <div class="operator-selector">
          <% if (hasMomo) { %>
            <label class="operator-card <%= defaultOp === 'momo' ? 'active' : '' %>" data-op="momo">
              <input type="radio" name="op_choice" value="momo" <%= defaultOp === 'momo' ? 'checked' : '' %>>
              <div class="op-radio-dot"></div>
              <div class="op-info">
                <div class="op-title-row">
                  <span class="momo-badge">MTN</span>
                  <span class="op-name">Mobile Money</span>
                </div>
                <span class="op-phone"><%= prettyPhone(w.momo_number) %><% if (w.momo_name) { %> · <b><%= w.momo_name %></b><% } %></span>
              </div>
            </label>
          <% } %>

          <% if (hasOm) { %>
            <label class="operator-card <%= defaultOp === 'om' ? 'active' : '' %>" data-op="om">
              <input type="radio" name="op_choice" value="om" <%= defaultOp === 'om' ? 'checked' : '' %>>
              <div class="op-radio-dot"></div>
              <div class="op-info">
                <div class="op-title-row">
                  <span class="om-badge">Orange</span>
                  <span class="op-name">Orange Money</span>
                </div>
                <span class="op-phone"><%= prettyPhone(w.om_number) %><% if (w.om_name) { %> · <b><%= w.om_name %></b><% } %></span>
              </div>
            </label>
          <% } %>
        </div>

        <!-- Étape 3 : Composer le code USSD (Bouton d'appel mobile + Copie) -->
        <div class="ussd-action-box">
          <a href="tel:*126*1*1*<%= momoClean || omClean %>*10000%23" id="ussdDialBtn" class="btn btn-ussd op-<%= defaultOp %>">
            <i class="fa-solid fa-phone"></i> <span id="ussdBtnLabel">Composer le code <%= defaultOp === 'om' ? 'Orange' : 'MoMo' %> (10 000 FCFA)</span>
          </a>
          <p class="ussd-hint"><i class="fa-solid fa-mobile-screen"></i> Ouvre directement votre clavier d'appel avec le code pré-rempli. Entrez simplement votre code secret pour valider.</p>

          <div class="ussd-copy-box">
            <span class="ussd-copy-label">Ou copiez ce code pour le composer :</span>
            <div class="ussd-code-display">
              <code id="ussdCodeText"><%= defaultOp === 'om' ? '#150*1*1*' + omClean + '*10000#' : '*126*1*1*' + momoClean + '*10000#' %></code>
              <button type="button" class="btn-copy-code" id="copyUssdBtn" data-copy="<%= defaultOp === 'om' ? '#150*1*1*' + omClean + '*10000#' : '*126*1*1*' + momoClean + '*10000#' %>">
                <i class="fa-regular fa-copy"></i> Copier le code
              </button>
            </div>
          </div>
        </div>

        <!-- Étape 4 : Confirmer le transfert aux mariés -->
        <form method="post" action="/i/<%= w.slug %>/cagnotte" class="form cagnotte-confirm-form">
          <input type="hidden" name="amount" id="formAmount" value="10000">
          <input type="hidden" name="operator" id="formOperator" value="<%= defaultOp %>">

          <div class="cagnotte-step" style="margin-top:1.5rem">
            <span class="step-badge">3</span>
            <span class="step-label">Confirmez votre cadeau pour le livre d'or</span>
          </div>

          <label>Votre nom complet ou famille
            <input name="name" maxlength="100" value="<%= guest ? guest.name : '' %>" placeholder="Ex : M. & Mme Eto'o ou Laissez vide pour anonyme">
          </label>
          <label>Votre numéro de téléphone (facultatif)
            <input name="phone" type="tel" inputmode="tel" placeholder="6XX XX XX XX" value="<%= guest && guest.phone ? prettyPhone(guest.phone) : '' %>">
          </label>
          <label>Votre message de félicitations
            <textarea name="message" rows="2" maxlength="300" placeholder="Tous nos vœux de bonheur pour votre nouvelle vie…"></textarea>
          </label>
          <button class="btn btn-gold btn-block" <%= isDraft ? 'disabled' : '' %> style="margin-top:.8rem">
            <i class="fa-solid fa-heart"></i> J'ai effectué mon transfert
          </button>
        </form>
      </div>
    <% } %>
  </section>
  <% } %>

  <!-- LIVRE D'OR -->
  <% if (wishes.length) { %>
  <section class="section wishes reveal">
    <h2 class="section-title">Livre d'or</h2>
    <div class="ornament">❦</div>
    <div class="wish-list">
      <% wishes.forEach(function(m) { %><blockquote><p>« <%= m.message %> »</p><cite>— <%= m.name %></cite></blockquote><% }) %>
    </div>
  </section>
  <% } %>

  <footer class="footer">
    <p class="script big"><%= names %></p>
    <% if (w.event_date) { %><p><%= fmtDate(w.event_date, { weekday: undefined }) %></p><% } %>
    <p class="made-by">Faire-part digital par <a href="/?ref=<%= w.slug %>"><%= brand %></a> · Créez le vôtre</p>
  </footer>
</main>

  <nav class="bottom-nav">
    <a href="#programme"><i class="fa-solid fa-scroll"></i><span>Programme</span></a>
    <% if (venueQuery) { %><a href="#lieu"><i class="fa-solid fa-location-dot"></i><span>Lieu</span></a><% } %>
    <a href="#rsvp" class="main"><i class="fa-solid fa-envelope-open-text"></i><span>Répondre</span></a>
    <% if (w.cagnotte_enabled) { %><a href="#cagnotte"><i class="fa-solid fa-gift"></i><span>Cagnotte</span></a><% } %>
  </nav>

<div class="lightbox" id="lightbox" hidden><img alt=""><button aria-label="Fermer">✕</button></div>
<script src="/static/js/invite.js?v=10.0" defer></script>
</body>
</html>
