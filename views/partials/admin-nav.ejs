<div class="topbar">
  <div class="container topbar-container">
    <a class="logo" href="/admin"><i class="fa-solid fa-ring"></i> <%= brand.split(' ')[0] %> <span style="color:#d9b86c">Admin</span></a>
    <nav class="topbar-links">
      <a href="/admin"><i class="fa-solid fa-chart-pie"></i> <span>Dashboard</span></a>
      <a href="/admin/mariages/new" class="btn btn-gold btn-sm"><i class="fa-solid fa-plus"></i> <span>Nouveau</span></a>
      <a href="/" target="_blank" class="topbar-link-subtle"><i class="fa-solid fa-arrow-up-right-from-square"></i> <span>Site</span></a>
      <button type="button" class="topbar-link-danger topbar-logout-btn" id="openLogoutModal" aria-label="Se déconnecter" title="Se déconnecter">
        <i class="fa-solid fa-right-from-bracket"></i>
      </button>
    </nav>
  </div>
</div>

<!-- Modal Pop-up Déconnexion (Mobile-first, UI/UX premium) -->
<div class="admin-logout-modal-backdrop" id="adminLogoutModal" role="dialog" aria-modal="true" aria-labelledby="logoutModalTitle" style="display: none;">
  <div class="admin-logout-sheet">
    <div class="admin-logout-icon">
      <i class="fa-solid fa-arrow-right-from-bracket"></i>
    </div>
    <h3 id="logoutModalTitle">Déconnexion</h3>
    <p>Souhaitez-vous vraiment fermer votre session administrateur ?</p>
    <div class="admin-logout-actions">
      <button type="button" class="btn-logout-cancel" id="closeLogoutModal">Annuler</button>
      <a href="/admin/logout" class="btn-logout-confirm">
        <i class="fa-solid fa-right-from-bracket"></i> Se déconnecter
      </a>
    </div>
  </div>
</div>

<style>
  .topbar-logout-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.05rem;
    line-height: 1;
  }
  .admin-logout-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 99999;
    background: rgba(18, 14, 10, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    opacity: 0;
    transition: opacity .25s ease;
  }
  .admin-logout-modal-backdrop.is-active {
    opacity: 1;
  }
  .admin-logout-sheet {
    background: #ffffff;
    border-radius: 24px;
    width: 100%;
    max-width: 380px;
    padding: 2rem 1.6rem 1.6rem;
    text-align: center;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35), 0 0 0 1px rgba(184, 145, 63, 0.15);
    transform: translateY(20px) scale(0.96);
    transition: transform .28s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .admin-logout-modal-backdrop.is-active .admin-logout-sheet {
    transform: translateY(0) scale(1);
  }
  .admin-logout-icon {
    width: 60px;
    height: 60px;
    margin: 0 auto 1.2rem;
    border-radius: 50%;
    background: #fee2e2;
    color: #dc2626;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    box-shadow: 0 0 0 8px rgba(239, 68, 68, 0.1);
  }
  .admin-logout-sheet h3 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--ink, #1d1a16);
    margin: 0 0 .5rem;
    font-family: 'Cormorant Garamond', Georgia, serif;
  }
  .admin-logout-sheet p {
    font-size: .94rem;
    color: var(--muted, #6f675c);
    line-height: 1.5;
    margin: 0 0 1.6rem;
  }
  .admin-logout-actions {
    display: flex;
    gap: .75rem;
    flex-direction: column-reverse;
  }
  @media (min-width: 480px) {
    .admin-logout-actions {
      flex-direction: row;
    }
  }
  .btn-logout-cancel {
    flex: 1;
    min-height: 46px;
    padding: 0 1rem;
    border-radius: 12px;
    border: 1px solid var(--line, #ebe4d8);
    background: #f8f6f2;
    color: var(--ink, #1d1a16);
    font: 600 .92rem Inter, system-ui, sans-serif;
    cursor: pointer;
    transition: all .2s;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .btn-logout-cancel:hover {
    background: #ece5d8;
    border-color: #d6ccbd;
  }
  .btn-logout-confirm {
    flex: 1.3;
    min-height: 46px;
    padding: 0 1.2rem;
    border-radius: 12px;
    border: none;
    background: linear-gradient(135deg, #dc2626, #b91c1c);
    color: #ffffff !important;
    font: 600 .92rem Inter, system-ui, sans-serif;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(220, 38, 38, 0.35);
    transition: all .2s;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .5rem;
  }
  .btn-logout-confirm:hover {
    background: linear-gradient(135deg, #b91c1c, #991b1b);
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(220, 38, 38, 0.45);
  }
</style>

<script>
  (function() {
    const modal = document.getElementById('adminLogoutModal');
    const openBtn = document.getElementById('openLogoutModal');
    const closeBtn = document.getElementById('closeLogoutModal');
    if (!modal || !openBtn) return;

    function openModal() {
      modal.style.display = 'flex';
      // Force un reflow pour déclencher l'animation CSS
      void modal.offsetHeight;
      modal.classList.add('is-active');
      document.body.style.overflow = 'hidden';
      if (closeBtn) closeBtn.focus();
    }

    function closeModal() {
      modal.classList.remove('is-active');
      document.body.style.overflow = '';
      setTimeout(function() {
        if (!modal.classList.contains('is-active')) {
          modal.style.display = 'none';
        }
      }, 250);
      openBtn.focus();
    }

    openBtn.addEventListener('click', openModal);
    if (closeBtn) closeBtn.addEventListener('click', closeModal);

    modal.addEventListener('click', function(e) {
      if (e.target === modal) closeModal();
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && modal.classList.contains('is-active')) {
        closeModal();
      }
    });
  })();
</script>
