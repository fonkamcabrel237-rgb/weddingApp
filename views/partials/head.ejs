<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%
    const pageTitle = typeof title !== 'undefined' && title ? `${title} · ${brand}` : `${brand} — Faire-part digitaux d'exception`;
    const pageDesc = typeof metaDesc !== 'undefined' && metaDesc ? metaDesc : "Faire-part digitaux interactifs, RSVP WhatsApp en ligne, pass VIP avec table et cagnotte Mobile Money & Orange Money sans intermédiaire.";
    const pageImg = typeof ogImage !== 'undefined' && ogImage ? ogImage : `${baseUrl}/static/img/og-cover.jpg`;
    const pageUrl = `${baseUrl}${typeof path !== 'undefined' ? path : ''}`;
  %>
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= pageDesc %>">
  <% if (typeof noindex !== 'undefined' && noindex) { %><meta name="robots" content="noindex"><% } %>

  <!-- Open Graph / WhatsApp / Facebook -->
  <meta property="og:site_name" content="<%= brand %>">
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= pageDesc %>">
  <meta property="og:url" content="<%= pageUrl %>">
  <meta property="og:image" content="<%= pageImg %>">
  <meta property="og:image:secure_url" content="<%= pageImg %>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:alt" content="<%= brand %>">

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= pageTitle %>">
  <meta name="twitter:description" content="<%= pageDesc %>">
  <meta name="twitter:image" content="<%= pageImg %>">

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/static/img/favicon.png">
  <link rel="apple-touch-icon" href="/static/img/favicon.png">

  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400;1,700&family=Great+Vibes&family=Inter:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;0,800;0,900;1,700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link rel="stylesheet" href="/static/css/app.css?v=11.0">
  <% if (typeof extraCss !== 'undefined' && extraCss) { %><link rel="stylesheet" href="/static/css/<%= extraCss %>?v=11.0"><% } %>
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
